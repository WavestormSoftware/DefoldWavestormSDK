-- Blobdown-style flow: start through the launcher, make or join a lobby, ready up, host starts, then P2P with net.send.
-- Keys (bind them in input/game.input_binding): "create", "ready", "start", "ping".
local ws = require "wavestorm.ws"

function init(self)
  msg.post(".", "acquire_input_focus")
  if ws.restart_if_needed("lobby-example") then return sys.exit(0) end -- not started by the launcher: it relaunches us properly
  local ok, err = ws.init()
  if not ok then print(ws.error_message(err)); return end -- the game still runs offline

  print("hello " .. ws.user().username)
  ws.set_presence("In the menu", { mode = "menu" })
  ws.lobby.on("joined", function(l) ws.set_presence("In a lobby", { lobby = tostring(l.id) }) end)
  ws.lobby.on("member_joined", function() print("members:", #ws.lobby.current.members) end)
  ws.lobby.on("started", function()
    -- teams are the same on every machine because members are sorted by user id
    for i, m in ipairs(ws.lobby.members_sorted()) do print(m.username, "team", (i % 2) + 1) end
  end)
  ws.net.on_packet(function(user_id, bytes) print("packet from", user_id, bytes) end)
end

function on_input(self, action_id, action)
  if not action.pressed or not ws.available then return end
  if action_id == hash("create") then ws.lobby.create({ type = "friends", max = 8, data = { mode = "ffa" } }, function(ok, l) print("create", ok, ok and l.id) end)
  elseif action_id == hash("ready") then ws.lobby.set_ready(true)
  elseif action_id == hash("start") then ws.lobby.start(function(ok, r) if not ok then print("cannot start:", r.error) end end)
  elseif action_id == hash("ping") then ws.net.broadcast("ping")
  end
end

function final(self) ws.shutdown() end
